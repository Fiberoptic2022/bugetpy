; Copy this file to env.ini and fill in your real values.
; env.ini is gitignored, so your keys/URLs never get committed.

[OPEN_WEBUI]
BASE_URL = http://192.168.30.22:3000
API_KEY = your-open-webui-api-key
; Must match a model name your Open WebUI server actually has (check with
; test_connection.py, which lists available models).
MODEL = gemma4:12b

[ANTHROPIC]
API_KEY = your-anthropic-api-key

[OPEN_AI]
OPENAI_API_KEY = your-openai-api-key

[SERPER]
SERPER_API_KEY = your-serper-api-key
